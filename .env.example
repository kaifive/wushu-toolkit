# Copy to .env.local for local dev, and set the same values in Vercel.

# Public site URL (canonical links, legacy redirect target)
NEXT_PUBLIC_SITE_URL=https://wushu-toolkit.vercel.app
# Where "Request a pass" links until payments exist (optional)
NEXT_PUBLIC_CONTACT_URL=

# Firebase web config (Project settings → General → Your apps). Accounts are off when empty.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Base64 of the service-account JSON:  base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT=
# Comma-separated Firebase uids allowed to grant passes from /account
ADMIN_UIDS=
